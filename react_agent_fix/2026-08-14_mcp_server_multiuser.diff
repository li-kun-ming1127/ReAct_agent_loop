+def _decode_token_part(value: str) -> bytes:
+    padding = "=" * (-len(value) % 4)
+    return base64.urlsafe_b64decode(value + padding)
+
+
+def verify_context_token(token: str) -> dict[str, Any] | None:
+    """Verify the HMAC token carrying user/session/knowledge-base identity."""
+    if len(MCP_TOKEN_SECRET.encode("utf-8")) < 32:
+        return None
+    try:
+        payload_part, signature_part = token.split(".", 1)
+        expected = hmac.new(
+            MCP_TOKEN_SECRET.encode("utf-8"),
+            payload_part.encode("ascii"),
+            hashlib.sha256,
+        ).digest()
+        signature = _decode_token_part(signature_part)
+        if not hmac.compare_digest(signature, expected):
+            return None
+        payload = json.loads(_decode_token_part(payload_part))
+    except (ValueError, UnicodeError, binascii.Error, json.JSONDecodeError):
+        return None
+
+    if not isinstance(payload, dict):
+        return None
+    required = ("sub", "sid", "kb", "iat", "exp", "aud", "scopes")
+    if not all(key in payload for key in required):
+        return None
+    now = int(time.time())
+    try:
+        issued_at = int(payload["iat"])
+        expires_at = int(payload["exp"])
+    except (TypeError, ValueError):
+        return None
+    if payload["aud"] != MCP_TOKEN_AUDIENCE or expires_at <= now:
+        return None
+    if issued_at > now + 30 or expires_at - issued_at > 2 * MCP_TOKEN_TTL_SECONDS:
+        return None
+    if payload["kb"] != KNOWLEDGE_BASE_ID:
+        return None
+    if not isinstance(payload["scopes"], list) or not all(
+        isinstance(scope, str) for scope in payload["scopes"]
+    ):
+        return None
+    if MCP_REQUIRED_SCOPE not in payload["scopes"]:
+        return None
+    if not all(
+        isinstance(payload[key], str) and IDENTIFIER_PATTERN.fullmatch(payload[key])
+        for key in ("sub", "sid", "kb")
+    ):
+        return None
+    return payload
+
+
+class SignedContextTokenVerifier:
+    """FastMCP verifier for short-lived, HMAC-signed context tokens."""
+
+    async def verify_token(self, token: str) -> AccessToken | None:
+        payload = verify_context_token(token)
+        if payload is None:
+            LOGGER.warning("Rejected invalid or expired MCP access token")
+            return None
+        return AccessToken(
+            token=token,
+            client_id=str(payload["sub"]),
+            subject=str(payload["sub"]),
+            scopes=list(payload["scopes"]),
+            expires_at=int(payload["exp"]),
+            resource=KNOWLEDGE_BASE_ID,
+            claims=payload,
+        )
+
+
+def require_request_identity() -> tuple[str, str, str]:
+    """Read verified identity claims and enforce this server's knowledge base."""
+    access_token = get_access_token()
+    claims = access_token.claims if access_token else None
+    if not isinstance(claims, dict):
+        raise PermissionError("缺少已验证的 MCP 访问身份。")
+    user_id = str(claims.get("sub", ""))
+    session_id = str(claims.get("sid", ""))
+    knowledge_base_id = str(claims.get("kb", ""))
+    if knowledge_base_id != KNOWLEDGE_BASE_ID:
+        raise PermissionError("无权访问指定知识库。")
+    return user_id, session_id, knowledge_base_id
+
